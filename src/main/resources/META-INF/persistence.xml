<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="tareas" transaction-type="JTA">
        <!-- El datasource lo define WildFly (ver docker/configurar-wildfly.cli).
             Las credenciales nunca están en el código. -->
        <jta-data-source>java:jboss/datasources/TareasDS</jta-data-source>
        <class>tareas.dominio.Tarea</class>
        <properties>
            <!-- El esquema lo controla db/schema.sql, no Hibernate -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
